  <script>
    // DÁN LINK GOOGLE APPS SCRIPT WEB APP CỦA BẠN VÀO ĐÂY:
    const API_URL = "https://script.google.com/macros/s/AKfycbxAcKb5Ok_eGG9151MoMLmYhMmCxn58eDKYJgokkP22NbaMk5JU0vKamysQGOT63p7l/exec";

    
    // Link trang hiện tại để tạo mã QR
    const QR_TRA_CUU_URL = window.location.href;

    document.addEventListener("DOMContentLoaded", function() {
      initQRCode();
    });

    function initQRCode() {
      const qrContainer = document.getElementById("indexQrcode");
      if (qrContainer) {
        new QRCode(qrContainer, {
          text: QR_TRA_CUU_URL,
          width: 150,
          height: 150,
          colorDark : "#0f172a",
          colorLight : "#ffffff",
          correctLevel : QRCode.CorrectLevel.H
        });
      }
    }

    function downloadIndexQR() {
      setTimeout(function() {
        const img = document.querySelector("#indexQrcode img");
        if (img && img.src) {
          const a = document.createElement("a");
          a.href = img.src;
          a.download = "Ma_QR_Tra_Cuu_THPT_Nguyen_Duy_Trinh.png";
          a.click();
        } else {
          alert("Mã QR đang được khởi tạo, vui lòng bấm lại!");
        }
      }, 200);
    }

    function formatDateVN(dateStr) {
      if (!dateStr) return "";
      var str = String(dateStr).trim();
      if (str.includes("T")) str = str.split("T")[0];
      if (str.includes("-")) {
        var parts = str.split("-");
        if (parts.length === 3 && parts[0].length === 4) {
          return parts[2] + "/" + parts[1] + "/" + parts[0];
        }
      }
      return str;
    }

    // Hàm tra cứu gọi trực tiếp qua API
    function handleSearch() {
      const kw = document.getElementById('searchInput').value.trim();
      const btn = document.getElementById('btnSearch');
      const btnText = document.getElementById('btnSearchText');
      const resultsDiv = document.getElementById('searchResults');
      const msgDiv = document.getElementById('searchMessage');
      const tbody = document.getElementById('tableBody');

      if (!kw) { alert('Vui lòng nhập SBD hoặc Họ tên!'); return; }

      btn.disabled = true;
      btnText.innerHTML = '<span class="loader"></span> Đang tìm...';

      // Gọi Fetch API kết nối Google Sheets
      fetch(`${API_URL}?action=traCuu&sbd=${encodeURIComponent(kw)}`)
        .then(response => response.json())
        .then(res => {
          btn.disabled = false;
          btnText.innerText = 'TRA CỨU';
          resultsDiv.classList.remove('hidden');

          if (res.status === "success" && res.data) {
            let item = res.data;
            msgDiv.innerText = `Tìm thấy kết quả:`;
            var ngaySinhFormatted = formatDateVN(item.NgaySinh || item.ngaySinh);
            
            let html = `<tr class="hover:bg-slate-50 transition">
              <td class="p-2.5 font-mono font-bold text-blue-900">${item.SBD || item.sbd}</td>
              <td class="p-2.5 font-bold uppercase text-slate-800">${item.HoTen || item.hoTen}</td>
              <td class="p-2.5 text-slate-600 font-medium">${ngaySinhFormatted}</td>
              <td class="p-2.5 text-center font-bold text-amber-700">${item.DiemXetTuyen || item.tongDiem || ''}</td>
              <td class="p-2.5 text-center"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded-full font-bold text-[10px]">${item.TrangThai || item.trangThai || 'Đã trúng tuyển'}</span></td>
            </tr>`;
            
            tbody.innerHTML = html;
          } else {
            msgDiv.innerText = 'Không tìm thấy dữ liệu phù hợp!';
            tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-400">Không có kết quả phù hợp với từ khóa "${kw}"</td></tr>`;
          }
        })
        .catch(err => {
          btn.disabled = false;
          btnText.innerText = 'TRA CỨU';
          alert('Lỗi tra cứu: ' + err.message);
        });
    }
  </script>
